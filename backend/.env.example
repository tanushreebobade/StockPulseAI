# StockPulse AI Backend Environment Configuration

# Server Port
PORT=5000

# Node Environment (development | production)
NODE_ENV=development

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# MongoDB Connection URL
MONGO_URL=mongodb://localhost:27017/stockpulse_db

# Google Gemini API Key (get free key at https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY_HERE

# Gemini Model (e.g. gemini-1.5-flash, gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# NewsAPI Key (optional - get at https://newsapi.org/ - leaves empty for mock news)
NEWSAPI_API_KEY=

# Finnhub API Key (optional - get at https://finnhub.io/ - leaves empty for mock quotes)
FINNHUB_API_KEY=

# Price Feed Data Source (MOCK or LIVE)
DATA_SOURCE=MOCK

# Allowed CORS Origin (use * for local dev or your domain in production)
CORS_ORIGIN=*

# Whether to run the BullMQ worker in the same process as the API server
# Set to true for single-process local development, false when running dedicated worker container
RUN_WORKER_IN_PROCESS=true
